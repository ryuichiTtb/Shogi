generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String                 @id @default(cuid())
  kind          String                 @default("guest") // "guest" | "account"
  clerkUserId   String?                @unique
  email         String?
  name          String                 @default("Player")
  createdAt     DateTime               @default(now())
  games         Game[]
  stats         PlayerStats?
  collections   PlayerCardCollection[]
  decks         Deck[]
  guestSessions GuestSession[]
  preference    UserPreference?
}

model GuestSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardBackStyle String   @default("seigaiha")
  theme         String   @default("system")
  // Issue #250: null = 未設定 = コード既定 (DEFAULT_BOARD_LAYOUT_ID) を適用する。
  // ★@default を意図的に持たない: DB 側に既定値を置くと、コード側の既定を変えても
  // 既存行・新規行とも DB の旧既定で埋まり続け、既定変更が誰にも届かなくなる
  // (実際に light-2 が固着し #250 の原因になった)。値を書くのは
  // saveBoardLayoutPreference (ユーザーの明示選択) のみ。
  // ⚠️ 上の cardBackStyle / theme は同型の構造 (DB 既定 + create 句に実値) のままなので、
  // それらの既定を変える際は同じ手当て (nullable 化 + 既存行リセット) が必要になる。
  boardLayout   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Game {
  id          String     @id @default(cuid())
  playerId    String
  player      User       @relation(fields: [playerId], references: [id])
  playerColor String     // "sente" | "gote"
  difficulty  String     // "beginner" | "intermediate" | "advanced"
  variantId   String     @default("standard")
  characterId String     @default("sakura")
  status      String     // "active" | "checkmate" | "resign" | "repetition" | "impasse" | "timeout"
  winner      String?    // "sente" | "gote" | "draw" | null
  boardState  Json
  gameConfig  Json
  cardState   Json? // card-shogi variant の場合のみ使用 (マナ/手札/山札/トラップ等)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  moves       GameMove[]
}

model GameMove {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  moveNum   Int
  player    String
  moveData  Json
  notation  String
  comment   String?
  createdAt DateTime @default(now())

  @@unique([gameId, moveNum])
  @@index([gameId])
}

model PlayerStats {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  rating Int    @default(1500)
  wins   Int    @default(0)
  losses Int    @default(0)
  draws  Int    @default(0)
}

// カード将棋 (card-shogi variant) 用テーブル群

// カードマスタ (CardDefinition と同期)
model Card {
  id          String                 @id // CardDefinition.id と一致 ("mana_up" 等)
  kind        String // "normal" | "trap"
  name        String
  description String
  cost        Int
  rarity      String                 @default("common") // "common" | "rare" | "epic"
  effectId    String // effects.ts でディスパッチ
  targeting   String                 @default("none") // "none" | "ownPiece" | "enemyPiece" | "square"
  createdAt   DateTime               @default(now())
  collections PlayerCardCollection[]
  deckEntries DeckEntry[]
}

// プレイヤー所持カード
model PlayerCardCollection {
  id     String @id @default(cuid())
  userId String
  cardId String
  count  Int    @default(1)
  user   User   @relation(fields: [userId], references: [id])
  card   Card   @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
}

// デッキ編成
model Deck {
  id        String      @id @default(cuid())
  userId    String
  name      String      @default("デフォルトデッキ")
  isDefault Boolean     @default(true)
  user      User        @relation(fields: [userId], references: [id])
  entries   DeckEntry[]
  createdAt DateTime    @default(now())
}

// デッキ内のカード編成
model DeckEntry {
  id     String @id @default(cuid())
  deckId String
  cardId String
  count  Int    @default(1)
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id])

  @@unique([deckId, cardId])
}

// 学習用棋譜データ収集 (Issue #245 フェーズ0)。
// 既存の Game/GameMove (= 最終状態のみ保持・各手番の cardState/eventLog 不在) とは分離し、
// 学習教材として「1対局の全操作・全状態」を per-decision で保存する専用テーブル。

// 学習用「1試合」= 人間対局 or 自己対戦。勝敗ラベルの単一情報源 (サンプルへ非正規化しない)。
model TrainingGame {
  id               String           @id @default(cuid())
  source           String // "human" | "self_play"
  variantId        String           @default("card-shogi")
  // 両者の素性 (人間側は null)。学習データ品質フィルタ用。
  senteDifficulty  String?
  senteCharacterId String?
  goteDifficulty   String?
  goteCharacterId  String?
  humanColor       String? // "sente" | "gote" | null (self_play)
  deckSpecSente    Json? // デッキ構成 (人間側は未保持のため null 許容)
  deckSpecGote     Json?
  // 結果ラベル (終局時に確定)。
  winner           String? // "sente" | "gote" | "draw" | null (中断 = 学習除外)
  finalStatus      String           @default("active") // GameStatus
  moveCount        Int              @default(0)
  // データ来歴 (弱い AI 由来データを高品質扱いしないためのフィルタキー)。
  engineVersion    String?
  sourceGameId     String? // human 時、元 Game.id への参照 (任意・トレース用)
  createdAt        DateTime         @default(now())
  samples          TrainingSample[]

  @@index([source])
  @@index([createdAt])
}

// 学習用「1決定点」のスナップショット (行動前の局面 + カード状態 + 採用行動 + 発生イベント)。
// move / playCard / draw の各操作で 1 行。double_move はターン単位 1 行 (events に move×2)。
model TrainingSample {
  id             String       @id @default(cuid())
  trainingGameId String
  trainingGame   TrainingGame @relation(fields: [trainingGameId], references: [id], onDelete: Cascade)
  plyIndex       Int // 0 始まりの決定通し番号 (試合内で一意)
  moveCount      Int // その時点の gameState.moveCount (card/draw では据置)
  sideToMove     String // "sente" | "gote"
  boardState     Json // serializeBoardForTraining (行動前): 盤面/持ち駒/手番/手数/終局 (moveHistory/positionHistory 除外)
  cardState      Json // serializeCardState (行動前): マナ/上限/手札/山札/墓地/トラップ/状態異常/ドロー進捗
  action         Json // 採用 TurnAction { kind: "move" | "draw" | "playCard", ... }
  events         Json // 発生 GameEvent[] (マナ増減/盤面効果/トラップ/二手指し軌跡。at は剥がす)
  createdAt      DateTime     @default(now())

  @@unique([trainingGameId, plyIndex])
}
